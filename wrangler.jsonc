{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "cut-house-moon-hp",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "prod": {
      "name": "cut-house-moon-hp",
      "images": {
        "binding": "IMAGES",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "cut-house-moon-hp",
        },
      ],
    },
    "stg": {
      "name": "cut-house-moon-hp-stg",
      "images": {
        "binding": "IMAGES",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "cut-house-moon-hp-stg",
        },
      ],
    },
    "dev": {
      "name": "cut-house-moon-hp-dev",
      "images": {
        "binding": "IMAGES",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "cut-house-moon-hp-dev",
        },
      ],
    },
  },
}
